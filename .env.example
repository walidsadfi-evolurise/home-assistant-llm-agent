HA_AGENT_HA_URL=http://homeassistant.local:8123
HA_AGENT_HA_TOKEN=                       # long-lived access token
HA_AGENT_POLICY_FILE=policy.yaml
HA_AGENT_AUDIT_FILE=data/audit.jsonl
HA_AGENT_PLANNER=rules                   # rules | anthropic | openai
HA_AGENT_LLM_MODEL=claude-haiku-4-5
# HA_AGENT_ANTHROPIC_API_KEY=
# HA_AGENT_OPENAI_API_KEY=
# HA_AGENT_LLM_BASE_URL=http://localhost:11434/v1
HA_AGENT_API_TOKEN=change-me
HA_AGENT_DRY_RUN=false
HA_AGENT_VERIFY_DELAY=1.0
